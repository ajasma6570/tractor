generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
}

enum WarrantyStatus {
  in_warranty
  out_warranty
}

enum BookingStatus {
  booked
  pending
  not_booked
}

enum CompletionStatus {
  in_progress
  completed
}

enum ServiceType {
  engine_oil
  transmission
  other
}

enum ServiceStatus {
  up_to_date
  expire_7_days
  expire_3_days
  expired
}

enum CallStatus {
  called
  not_answered
  rescheduled
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  phone     String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  calls CallRegister[] @relation("UserCalls")
}

model Technician {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  branch    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  schedules ServiceSchedule[]
  services  ServiceRecord[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String
  createdAt DateTime @default(now())

  vehicles  Vehicle[]
  schedules ServiceSchedule[]
  services  ServiceRecord[]
  calls     CallRegister[]
}

model Vehicle {
  id              Int            @id @default(autoincrement())
  customerId      Int
  chassisNumber   String         @unique
  engineNumber    String
  model           String
  branch          String
  hmr             Int?
  warrantyStatus  WarrantyStatus
  saleDate        DateTime
  lastServiceDate DateTime?
  serviceStatus   ServiceStatus  @default(up_to_date)
  createdAt       DateTime       @default(now())

  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  schedules ServiceSchedule[]
  services  ServiceRecord[]
  calls     CallRegister[]
}

model ServiceSchedule {
  id           Int           @id @default(autoincrement())
  vehicleId    Int
  customerId   Int
  bookingDate  DateTime
  bookingTime  String
  technicianId Int?
  serviceType  ServiceType
  status       BookingStatus
  createdAt    DateTime      @default(now())

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
}

model ServiceRecord {
  id               Int              @id @default(autoincrement())
  vehicleId        Int
  customerId       Int
  serviceType      ServiceType
  machineHour      Int?
  workDescription  String
  technicianId     Int?
  completionStatus CompletionStatus
  serviceDate      DateTime
  createdAt        DateTime         @default(now())

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
}

model CallRegister {
  id            Int           @id @default(autoincrement())
  vehicleId     Int
  customerId    Int
  callDate      DateTime
  callTime      String
  callStatus    CallStatus
  bookingStatus BookingStatus
  remarks       String?
  calledById    Int

  calledBy User     @relation("UserCalls", fields: [calledById], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
