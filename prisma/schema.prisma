generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
}

enum WarrantyStatus {
  in_warranty
  out_of_warranty
}

enum ServiceType {
  engine_oil
  transmission
}

enum ReminderStatus {
  up_to_date
  expire_7_days
  expire_3_days
  expired
}

enum CallStatus {
  called
  not_answered
  rescheduled
}

enum BookingStatus {
  booked
  not_booked
  pending
  completed
}

enum SchedulePriority {
  normal
  urgent
}

enum AuditAction {
  create
  update
  delete
  login
  status_change
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  phone     String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  calls     CallRegister[]
  auditLogs AuditLog[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String
  createdAt DateTime @default(now())

  vehicles  Vehicle[]
  calls     CallRegister[]
  schedules ServiceSchedule[]
}

model Vehicle {
  id             Int            @id @default(autoincrement())
  customerId     Int
  chassisNumber  String         @unique
  engineNumber   String         @unique
  model          String
  branch         String
  hmr            Int?
  warrantyStatus WarrantyStatus
  saleDate       DateTime
  createdAt      DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  reminders ServiceReminder[]
  services  ServiceHistory[]
  calls     CallRegister[]
  schedules ServiceSchedule[]
}

model Technician {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  branch    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  schedules ServiceSchedule[]
}

model ServiceReminder {
  id          Int         @id @default(autoincrement())
  vehicleId   Int
  serviceType ServiceType

  baseDate DateTime
  nextDue  DateTime
  status   ReminderStatus @default(up_to_date)

  isHandled Boolean @default(false)

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, serviceType])
}

model ServiceHistory {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  serviceDate DateTime
  notes       String

  engineOil    Boolean @default(false)
  transmission Boolean @default(false)
  otherWork    Boolean @default(false)

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model ServiceSchedule {
  id         Int @id @default(autoincrement())
  vehicleId  Int
  customerId Int

  bookingDate DateTime
  bookingTime String

  closingDate DateTime?

  technicianId Int?
  serviceType  ServiceType
  status       BookingStatus

  priority SchedulePriority @default(normal)

  createdAt DateTime @default(now())

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
}

model CallRegister {
  id         Int        @id @default(autoincrement())
  vehicleId  Int
  customerId Int
  callDate   DateTime
  callStatus CallStatus

  remarks    String?
  calledById Int

  createdAt DateTime @default(now())

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  calledBy User     @relation(fields: [calledById], references: [id])
}

model AuditLog {
  id Int @id @default(autoincrement())

  userId   Int?
  action   AuditAction
  entity   String // "Customer", "Vehicle", "Schedule" etc
  entityId Int?

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
